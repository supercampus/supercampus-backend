APP_ENV=development
HTTP_HOST=127.0.0.1
HTTP_PORT=4000
CONTROL_DATABASE_URL=postgresql://supercampus:change-me@localhost:5432/supercampus_control
# Used only by split-control-plane to identify the existing institution database.
DATABASE_URL=postgresql://supercampus:change-me@localhost:5432/supercampus_tenant_local
PRIMARY_TENANT_SLUG=tenant-local
DATABASE_MAX_CONNECTIONS=10
CORS_ALLOWED_ORIGINS=http://localhost:3000
JWT_ISSUER=https://auth.supercampus.local
JWT_AUDIENCE=supercampus-api
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
SESSION_REFRESH_TTL_SECONDS=2592000
RUST_LOG=info,supercampus=debug
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional testing identities. Never enable this in production and never commit real passwords.
SEED_TEST_USERS=false
TEST_TENANT_SLUG=tenant-local
TEST_TENANT_CODE=LOCAL
TEST_TENANT_NAME=SuperCampus Test Institution
TEST_TENANT_CITY=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_ADMIN_NAME=Admissions Test Admin
TEST_COUNSELOR_EMAIL=
TEST_COUNSELOR_PASSWORD=
TEST_COUNSELOR_NAME=Admissions Test Counselor
TEST_STUDENT_EMAIL=
TEST_STUDENT_PASSWORD=
TEST_STUDENT_NAME=Test Student
