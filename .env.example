# Runtime mode and HTTP server
NODE_ENV=development
PORT=4000
API_HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL — use the database service's internal hostname and port 5432 in Dokploy/Docker
DATABASE_URL=postgresql://supercampus:change-me@postgres-service:5432/supercampus
DATABASE_SSL=disable
PGPOOL_MAX=10

# JWT — generate a unique value of at least 32 characters; never commit the real secret
JWT_SECRET=replace-with-a-long-random-production-secret

# Gatepass Module
GATEPASS_SECRET="replace-with-a-long-random-gatepass-secret"

# Meta Cloud API (WhatsApp) — fill in real values when ready
META_WHATSAPP_TOKEN=""
META_WHATSAPP_PHONE_ID=""
META_WHATSAPP_API_VERSION="v19.0"
