APP_ENV=development
HTTP_HOST=127.0.0.1
HTTP_PORT=4000
HTTP_REQUEST_TIMEOUT_SECONDS=30
CONTROL_DATABASE_URL=postgresql://supercampus:change-me@localhost:5432/supercampus_control
# Used only by split-control-plane to identify the existing institution database.
DATABASE_URL=postgresql://supercampus:change-me@localhost:5432/supercampus_tenant_local
PRIMARY_TENANT_SLUG=tenant-local
DATABASE_MAX_CONNECTIONS=10
TENANT_DATABASE_MAX_CONNECTIONS=5
CORS_ALLOWED_ORIGINS=http://localhost:3000
JWT_ISSUER=https://auth.supercampus.local
JWT_AUDIENCE=supercampus-api
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
SESSION_REFRESH_TTL_SECONDS=2592000
RUST_LOG=info,supercampus=debug
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional OpenAI-compatible service used by timetable planning and the CRM assistant.
# Keep the key on the backend. A base ending in /v1 and a bare host URL are both accepted.
SUPERCAMPUS_AI_BASE_URL=
SUPERCAMPUS_AI_API_KEY=
SUPERCAMPUS_AI_MODEL=Qwen/Qwen2.5-7B-Instruct
SUPERCAMPUS_AI_TIMEOUT_SECONDS=25
# Legacy timetable-specific aliases remain supported.
TIMETABLE_AI_BASE_URL=
TIMETABLE_AI_API_KEY=
TIMETABLE_AI_MODEL=Qwen/Qwen2.5-7B-Instruct
TIMETABLE_AI_TIMEOUT_SECONDS=25

# Cloudinary media storage. Credentials stay server-side. Uploads are signed
# into supercampus/{tenantId}/media and accept images/PDFs up to 10 MB.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Twilio, for SMS and WhatsApp. Credentials stay server-side for the same reason
# Cloudinary's do: anything shipped in the mobile binary can be extracted from it,
# and these can spend money. The app asks the API to send; it never talks to Twilio.
#
# TWILIO_ACCOUNT_SID is the AC... identifier the REST API is addressed with. The
# SK.../secret pair below is an API Key, which authenticates against that account
# but does not replace it — both are required.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# One of these two. A messaging service is preferred: it holds the sender pool and
# the WhatsApp sender together, so the number can change without a redeploy.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM=
# The WhatsApp sender, in Twilio's own form, e.g. whatsapp:+14155238886.
TWILIO_WHATSAPP_FROM=

# Origin used to build password reset links. Must match where the frontend is served.
APP_PUBLIC_URL=http://localhost:3000

# Outbound email. Leave SMTP_HOST empty to log reset links instead of sending them,
# which is the intended local-development behaviour. Setting SMTP_HOST switches the
# API to real delivery and makes MAIL_FROM required.
SMTP_HOST=
SMTP_PORT=587
# Defaults to true only when SMTP_PORT is 465; otherwise the client uses STARTTLS.
SMTP_IMPLICIT_TLS=
# SMTP_USER and SMTP_PASSWORD must be set together, or both left empty.
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=SuperCampus <no-reply@supercampus.local>

# Optional testing identities. Never enable this in production and never commit real passwords.
SEED_TEST_USERS=false
TEST_TENANT_SLUG=tenant-local
TEST_TENANT_CODE=LOCAL
TEST_TENANT_NAME=SuperCampus Test Institution
TEST_TENANT_CITY=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_ADMIN_NAME=Admissions Test Admin
TEST_COUNSELOR_EMAIL=
TEST_COUNSELOR_PASSWORD=
TEST_COUNSELOR_NAME=Admissions Test Counselor
TEST_STUDENT_EMAIL=
TEST_STUDENT_PASSWORD=
TEST_STUDENT_NAME=Test Student
