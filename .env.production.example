APP_ENV=production
HTTP_HOST=0.0.0.0
HTTP_PORT=4000
HTTP_REQUEST_TIMEOUT_SECONDS=30

# Inject real credentials through Dokploy. Never commit their values.
CONTROL_DATABASE_URL=
DATABASE_MAX_CONNECTIONS=10
TENANT_DATABASE_MAX_CONNECTIONS=5
JWT_SECRET=
JWT_ISSUER=https://api.supercampus.ai
JWT_AUDIENCE=supercampus-api
JWT_ACCESS_TTL_SECONDS=900
SESSION_REFRESH_TTL_SECONDS=2592000

# Exact HTTPS browser origins only. Add published tenant application origins as needed.
CORS_ALLOWED_ORIGINS=https://supercampus.ai,https://www.supercampus.ai
APP_PUBLIC_URL=https://supercampus.ai/login

SEED_TEST_USERS=false
RUST_LOG=info,supercampus=info

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# See .env.example for what each of these is. All six stay server-side.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Gallabox (preferred WhatsApp provider).
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=gallabox
GALLABOX_API_URL=https://server.gallabox.com/devapi
GALLABOX_ACCOUNT_ID=
GALLABOX_API_KEY=
GALLABOX_API_SECRET=
GALLABOX_CHANNEL_ID=
GALLABOX_DEFAULT_TEMPLATE=
GALLABOX_TEMPLATE_ATTENDANCE=
GALLABOX_TEMPLATE_GATEPASS=
GALLABOX_TEMPLATE_FEES=
GALLABOX_TEMPLATE_EXAMINATION=
GALLABOX_TEMPLATE_LIBRARY=
GALLABOX_TEMPLATE_HOSTEL=
GALLABOX_TEMPLATE_TRANSPORT=
GALLABOX_TEMPLATE_GENERAL=
GALLABOX_TEMPLATE_GUARDIAN_APPROVAL=
GALLABOX_TEMPLATE_VISITOR_PASS=
GALLABOX_TEMPLATE_CRM=
SUPERCAMPUS_APP_URL=https://mec.supercampus.ai
WHATSAPP_EVENT_CATEGORIES=attendance,gatepass,fees,examination,library,hostel,transport
WHATSAPP_EVENT_LOOKBACK_HOURS=72

# Brevo API keys (`xkeysib-...`) use the HTTP transport and take precedence over
# the SMTP fallback below. Inject the real value through Dokploy only.
BREVO_API_KEY=
MAIL_FROM=SuperCampus <no-reply@supercampus.ai>

SMTP_HOST=
SMTP_PORT=587
SMTP_IMPLICIT_TLS=false
SMTP_USER=
SMTP_PASSWORD=

# Firebase Cloud Messaging is delivered by a separate notification-worker
# service built from the same image. Mount the JSON credential as a protected
# file; never paste its private key into this repository.
FCM_ENABLED=true
FIREBASE_PROJECT_ID=supercampus-production-5b1d9
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-admin.json
# Razorpay Standard Checkout. Configure these in the deployment secret store.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
