{
  "name": "supercampus-backend",
  "version": "1.0.0",
  "description": "SuperCampus API — Node.js / Express backend",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
